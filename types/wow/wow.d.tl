   -- questie:ScriptObject/CurveObjectBase.lua
   interface CurveObjectBase
      is userdata
      -- {"Environment": "All"}
      GetType: function(self): number
      -- {"Environment": "All", "ReturnsNeverSecret": true}
      HasSecretValues: function(self): boolean
      -- {"Environment": "All", "SecretArguments": "AllowedWhenUntainted"}
      SetType: function(self, number)
   end

   -- questie:ScriptObject/ColorCurveObject.lua
   interface ColorCurveObject
      is userdata, CurveObjectBase
      -- {"Environment": "All", "SecretArguments": "AllowedWhenUntainted"}
      AddPoint: function(self, number, colorRGBA)
      -- {"Environment": "All"}
      ClearPoints: function(self)
      -- {"Environment": "All", "ReturnsNeverSecret": true}
      Copy: function(self): ColorCurveObject
      -- {"ConstSecretAccessor": true, "Environment": "All", "SecretArguments": "AllowedWhenUntainted"}
      Evaluate: function(self, number): colorRGBA
      -- {"ConstSecretAccessor": true, "Environment": "All", "SecretArguments": "AllowedWhenUntainted"}
      EvaluateUnpacked: function(self, number): W.MaybeSecret<number>, W.MaybeSecret<number>, W.MaybeSecret<number>, W.MaybeSecret<number>
      -- {"ConstSecretAccessor": true, "Environment": "All", "SecretArguments": "AllowedWhenUntainted"}
      GetPoint: function(self, number): LuaColorCurvePoint
      -- {"Environment": "All"}
      GetPointCount: function(self): number
      -- {"Environment": "All"}
      GetPoints: function(self): W.Secret<W.SecretTable>
      -- {"Environment": "All", "SecretArguments": "AllowedWhenUntainted"}
      RemovePoint: function(self, number)
      -- {"Environment": "All", "SecretArguments": "AllowedWhenUntainted"}
      SetPoints: function(self, {LuaColorCurvePoint})
      -- {"Environment": "All"}
      SetToDefaults: function(self)
   end

   -- questie:FrameXML/Blizzard_SharedXML/Color.lua
   interface ColorMixin
      a: W.MaybeSecret<number>
      b: W.MaybeSecret<number>
      g: W.MaybeSecret<number>
      r: W.MaybeSecret<number>
      GenerateHexColor: function(self): W.MaybeSecret<string>
      GenerateHexColorMarkup: function(self): W.MaybeSecret<string>
      GetRGB: function(self): W.MaybeSecret<number>, W.MaybeSecret<number>, W.MaybeSecret<number>
      GetRGBA: function(self): W.MaybeSecret<number>, W.MaybeSecret<number>, W.MaybeSecret<number>, W.MaybeSecret<number>
      GetRGBAAsBytes: function(self): W.MaybeSecret<number>, W.MaybeSecret<number>, W.MaybeSecret<number>, W.MaybeSecret<number>
      GetRGBAsBytes: function(self): W.MaybeSecret<number>, W.MaybeSecret<number>, W.MaybeSecret<number>
      IsEqualTo: function(self, colorRGBA): W.MaybeSecret<boolean>
      SetRGB: function(self, number, number, number)
      SetRGBA: function(self, number, number, number, ? number)
      WrapTextInColorCode: function(self, string): W.MaybeSecret<string>
   end

